# Change both values before a production deployment.
ADMIN_PASSWORD=change-this-password
SESSION_SECRET=change-this-to-a-long-random-value

# Device-local playback works without an external service. Use "mock" only
# while developing the external-player UI, or "owntone" for AirPlay output.
PLAYBACK_BACKEND=disabled
OWNTONE_URL=http://owntone:3689
OWNTONE_OUTPUT_ID=
OWNTONE_MEDIA_DIRECTORY=/srv/media

DEFAULT_VOLUME=35
MAX_VOLUME=65
KIOSK_PLAYBACK_TARGET=local
# Defaults used until they are changed on Admin → System.
LOUDNESS_COMPENSATION_ENABLED=true
LOUDNESS_TARGET_LUFS=-16
LOUDNESS_SHORT_TERM_TARGET_LUFS=-13.5
VOLUME_CURVE_DIVISOR=74
MAX_UPLOAD_MB=2048
MAX_COVER_MB=10
MEDIA_PROCESSING_TIMEOUT_SECONDS=300
YOUTUBE_IMPORT_TIMEOUT_SECONDS=600

# The bundled yt-dlp release is copied into persistent storage and can update
# itself without rebuilding the image. Set the channel to nightly temporarily
# when a YouTube change has not reached stable yet.
YTDLP_AUTO_UPDATE=true
YTDLP_UPDATE_CHANNEL=stable
YTDLP_UPDATE_INTERVAL_HOURS=24

# Used by compose.yml. Pin this to a sha-* tag for reproducible deployments.
APP_IMAGE=ghcr.io/d1scolor/song-cards:latest
