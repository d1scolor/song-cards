# Public browser origin behind your reverse proxy.
BASE_URL=https://songs.example.com

# Change both values before a production deployment.
ADMIN_PASSWORD=change-this-password
SESSION_SECRET=change-this-to-a-long-random-value

# Use "mock" while developing the UI, or "owntone" on Linux.
PLAYBACK_BACKEND=mock
OWNTONE_URL=http://owntone:3689
OWNTONE_OUTPUT_ID=
OWNTONE_MEDIA_DIRECTORY=/srv/media

DEFAULT_VOLUME=35
MAX_VOLUME=65
MAX_UPLOAD_MB=100

# Used by compose.yml. Pin this to a sha-* tag for reproducible deployments.
APP_IMAGE=ghcr.io/example/song-cards:latest
